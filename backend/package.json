{
  "name": "wedding-website-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -e \"require('fs').readFile('./src/db/schema.sql','utf8',(e,sql)=>{if(e)throw e; require('./src/db/pool').query(sql).then(()=>{console.log('Schema applied'); process.exit(0);}).catch(err=>{console.error(err); process.exit(1);});})\"",
    "import-guests": "node scripts/import-guests.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
