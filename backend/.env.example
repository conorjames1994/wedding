# Postgres connection - Supabase/Neon/Railway all give you one connection string like this
DATABASE_URL=postgresql://user:password@host:5432/wedding
PGSSL=true

# Port the Express server listens on locally
PORT=4000

# Where the frontend is hosted, for CORS. Use * while developing, lock it down for prod.
CORS_ORIGIN=http://localhost:5173

# Shared password for the /admin dashboard - pick something only you two know
ADMIN_PASSWORD=change-me
